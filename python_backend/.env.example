# Flask backend configuration for contact email sending
# Copy to .env and fill with your SMTP provider details

# Allowed origins for CORS, comma-separated during local dev
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP settings
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_username_or_full_email
SMTP_PASS=your_app_password
# From email shown to recipients; fallback to SMTP_USER if not set
SMTP_FROM=website@unirolsairtex.com

# Optional: override default recipients; otherwise sends to admin and sales
# CONTACT_RECIPIENTS=admin@unirolsairtex.com,sales@unirolsairtex.com

# Flask app settings
PORT=5000
DEBUG=False
