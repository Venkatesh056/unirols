# Port for Flask server
PORT=5000

# CORS allowed origins (your website URL)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Admin key for retraining model
ADMIN_KEY=change-me-in-production

# Debug mode
DEBUG=True
